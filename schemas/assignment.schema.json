{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assignment_id",
    "created_at",
    "coordinator",
    "role",
    "objective",
    "project",
    "git",
    "scope",
    "artifacts",
    "startup",
    "inputs",
    "required_outputs",
    "verification",
    "reviewed_runs",
    "permissions",
    "supersedes"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "assignment_id": {
      "$ref": "#/$defs/id"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "coordinator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "run_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "role": {
      "$ref": "#/$defs/role"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container",
        "repository",
        "worktree"
      ],
      "properties": {
        "container": {
          "$ref": "#/$defs/absolute"
        },
        "repository": {
          "$ref": "#/$defs/absolute"
        },
        "worktree": {
          "anyOf": [
            {
              "$ref": "#/$defs/absolute"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "base_commit",
        "target_commit"
      ],
      "properties": {
        "branch": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "base_commit": {
          "$ref": "#/$defs/commit"
        },
        "target_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/commit"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "campaign_directory",
        "variant_id",
        "variant_directory"
      ],
      "properties": {
        "campaign_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "campaign_directory": {
          "anyOf": [
            {
              "$ref": "#/$defs/absolute"
            },
            {
              "type": "null"
            }
          ]
        },
        "variant_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/variant"
            },
            {
              "type": "null"
            }
          ]
        },
        "variant_directory": {
          "anyOf": [
            {
              "$ref": "#/$defs/absolute"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_directory",
        "run_id",
        "entrypoint",
        "run_path",
        "run_directory"
      ],
      "properties": {
        "root_directory": {
          "$ref": "#/$defs/absolute"
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "entrypoint": {
          "enum": [
            ".agent-artifacts",
            null
          ]
        },
        "run_path": {
          "$ref": "#/$defs/relative"
        },
        "run_directory": {
          "$ref": "#/$defs/absolute"
        }
      }
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "working_directory",
        "assignment_file",
        "bootstrap_file",
        "protocol_file"
      ],
      "properties": {
        "working_directory": {
          "$ref": "#/$defs/absolute"
        },
        "assignment_file": {
          "$ref": "#/$defs/absolute"
        },
        "bootstrap_file": {
          "$ref": "#/$defs/absolute"
        },
        "protocol_file": {
          "$ref": "#/$defs/absolute"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/absolute"
      },
      "uniqueItems": true
    },
    "required_outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relative"
      },
      "minItems": 2,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "manifest.json"
          }
        },
        {
          "contains": {
            "const": "report.md"
          }
        }
      ]
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewed_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "manifest_file",
          "manifest_sha256"
        ],
        "properties": {
          "run_id": {
            "$ref": "#/$defs/id"
          },
          "manifest_file": {
            "$ref": "#/$defs/absolute"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modify_source",
        "merge",
        "remove_worktree",
        "update_summary",
        "additional_writable_paths"
      ],
      "properties": {
        "modify_source": {
          "type": "boolean"
        },
        "merge": {
          "type": "boolean"
        },
        "remove_worktree": {
          "type": "boolean"
        },
        "update_summary": {
          "type": "boolean"
        },
        "additional_writable_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/absolute"
          },
          "uniqueItems": true
        }
      }
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "#/$defs/absolute"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hirozy/worktree-based-operator-engineering-protocol/schemas/assignment.schema.json",
  "title": "Worker Assignment Envelope v2",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "variant": {
      "type": "string",
      "pattern": "^V[0-9]{3,}$"
    },
    "absolute": {
      "type": "string",
      "pattern": "^/(?!$)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\x00\\n\\r]+$"
    },
    "relative": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\x00\\n\\r\\\\]+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "role": {
      "enum": [
        "implementation",
        "test",
        "benchmark",
        "review",
        "audit",
        "integration",
        "aggregation"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "enum": [
              "test",
              "benchmark",
              "review",
              "audit"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "git": {
            "properties": {
              "target_commit": {
                "$ref": "#/$defs/commit"
              }
            }
          },
          "permissions": {
            "properties": {
              "modify_source": {
                "const": false
              },
              "merge": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "not": {
              "const": "aggregation"
            }
          }
        }
      },
      "then": {
        "properties": {
          "project": {
            "properties": {
              "worktree": {
                "$ref": "#/$defs/absolute"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "enum": [
              "implementation",
              "integration"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "git": {
            "properties": {
              "branch": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "permissions": {
            "properties": {
              "modify_source": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "not": {
              "const": "integration"
            }
          }
        }
      },
      "then": {
        "properties": {
          "permissions": {
            "properties": {
              "merge": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "aggregation"
          }
        }
      },
      "then": {
        "properties": {
          "permissions": {
            "properties": {
              "modify_source": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
